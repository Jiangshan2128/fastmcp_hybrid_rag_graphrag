# ── RAG Embeddings (provider: qwen / bge-m3 / openai / huggingface) ─
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_API_KEY=sk-xxx
# EMBEDDING_BASE_URL=

# ── Qdrant vector store ──────────────────────────────────────────
# QDRANT_PATH=knowledge_base/qdrant_data  # default
# QDRANT_COLLECTION=ai_note_knowledge

# ── RAG Indexing ─────────────────────────────────────────────────
AUTO_INDEX_ON_START=true
WATCH_ENABLED=false

# ── GraphRAG LLM (entity extraction, summarization, search) ──────
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── GraphRAG Community Reports (豆包模型, higher token limit) ────
DOUBAO_API_KEY=xxx
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-2-1-turbo-260628

# ── GraphRAG Embeddings (DashScope, shared with RAG embeddings) ─
DASHSCOPE_API_KEY=sk-xxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
